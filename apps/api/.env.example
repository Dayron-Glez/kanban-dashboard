# Copia este fichero a .env para desarrollo local.

# Postgres local de Supabase (pnpm db:start). En producción, la cadena del
# pooler de Supabase en modo transacción (puerto 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Proyecto de Supabase cuyos tokens de sesión acepta la API (es pública). En
# producción, https://<ref>.supabase.co.
SUPABASE_URL=http://127.0.0.1:54321

# Orígenes que pueden llamar a la API desde el navegador, separados por comas.
CORS_ORIGINS=http://localhost:5173

PORT=3000
