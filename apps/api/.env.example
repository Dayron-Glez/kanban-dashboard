# Copia este fichero a .env para desarrollo local.

# Postgres local de Supabase (pnpm db:start). En producción, la cadena del
# pooler de Supabase en modo transacción (puerto 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# better-auth. BETTER_AUTH_URL es la URL pública de la WEB (en producción, la
# de Vercel): la API se sirve bajo su /api. El secreto firma las cookies de
# sesión; genera uno con `openssl rand -base64 32`.
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=

# Opcionales: para entrar con Google. La URI de redirección autorizada en
# Google Cloud es BETTER_AUTH_URL + /api/auth/callback/google.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

PORT=3000
