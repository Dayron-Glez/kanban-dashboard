        "alerts_title_check": {
          "name": "alerts_title_check",
          "value": "char_length(\"core\".\"alerts\".\"title\") between 1 and 120"
        },
        "alerts_cause_check": {
          "name": "alerts_cause_check",
          "value": "\"core\".\"alerts\".\"cause\" in ('unavailability', 'illness', 'strike', 'weather', 'permits', 'supplier', 'other')"
        },
        "alerts_certainty_check": {
          "name": "alerts_certainty_check",
          "value": "\"core\".\"alerts\".\"certainty\" in ('confirmed', 'possible')"
        },
        "alerts_scope_check": {
          "name": "alerts_scope_check",
          "value": "\"core\".\"alerts\".\"scope\" in ('project', 'targeted')"
        },
        "alerts_hours_mode_check": {
          "name": "alerts_hours_mode_check",
          "value": "\"core\".\"alerts\".\"hours_mode\" in ('daily', 'continuous')"
        },
        "alerts_dates_check": {
          "name": "alerts_dates_check",
          "value": "\"core\".\"alerts\".\"ends_on\" is null or \"core\".\"alerts\".\"ends_on\" >= \"core\".\"alerts\".\"starts_on\""
        },
        "alerts_all_day_check": {
          "name": "alerts_all_day_check",
          "value": "not \"core\".\"alerts\".\"all_day\" or (\"core\".\"alerts\".\"start_time\" is null and \"core\".\"alerts\".\"end_time\" is null and \"core\".\"alerts\".\"hours_mode\" is null)"
        },
        "alerts_start_time_check": {
          "name": "alerts_start_time_check",
          "value": "\"core\".\"alerts\".\"all_day\" or \"core\".\"alerts\".\"start_time\" is not null"
        },
        "alerts_single_day_check": {
          "name": "alerts_single_day_check",
          "value": "\"core\".\"alerts\".\"all_day\" or \"core\".\"alerts\".\"ends_on\" is distinct from \"core\".\"alerts\".\"starts_on\" or (\"core\".\"alerts\".\"hours_mode\" is null and \"core\".\"alerts\".\"end_time\" is not null and \"core\".\"alerts\".\"end_time\" > \"core\".\"alerts\".\"start_time\")"
        },
        "alerts_several_days_check": {
          "name": "alerts_several_days_check",
          "value": "\"core\".\"alerts\".\"all_day\" or \"core\".\"alerts\".\"ends_on\" is not distinct from \"core\".\"alerts\".\"starts_on\" or \"core\".\"alerts\".\"hours_mode\" is not null"
        },
        "alerts_daily_check": {
          "name": "alerts_daily_check",
          "value": "\"core\".\"alerts\".\"hours_mode\" is distinct from 'daily' or (\"core\".\"alerts\".\"end_time\" is not null and \"core\".\"alerts\".\"end_time\" > \"core\".\"alerts\".\"start_time\")"
        },
        "alerts_continuous_check": {
          "name": "alerts_continuous_check",
          "value": "\"core\".\"alerts\".\"hours_mode\" is distinct from 'continuous' or (\"core\".\"alerts\".\"end_time\" is null) = (\"core\".\"alerts\".\"ends_on\" is null)"
        }
      },
