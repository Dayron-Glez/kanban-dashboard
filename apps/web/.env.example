# Cópialo como .env.development.local y rellena la clave.

# Supabase local (pnpm db:start). Para apuntar a producción usa .env.prod.local
# con los valores del proyecto remoto y arranca con `pnpm --filter web dev:prod`.
VITE_SUPABASE_URL=http://127.0.0.1:54321

# El valor de PUBLISHABLE_KEY que muestra `pnpm db:status`.
VITE_SUPABASE_ANON_KEY=

# API propia (pnpm --filter api dev), a través del proxy /api de Vite. Con
# ella, los datos van a la API y de Supabase solo queda la sesión; sin ella,
# todo sigue yendo a Supabase.
VITE_API_URL=/api
