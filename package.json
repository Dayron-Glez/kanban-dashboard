{
  "name": "cauce-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:run": "turbo test:run",
    "test:int": "pnpm --filter api test:int",
    "typecheck": "turbo typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "db:start": "docker compose up -d --wait db && pnpm --filter api db:migrate",
    "db:stop": "docker compose stop db",
    "db:reset": "docker compose down -v && pnpm db:start",
    "db:seed": "docker compose exec -T db psql -U postgres -d cauce -v ON_ERROR_STOP=1 -f - < apps/api/seed.sql"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier --write"
    ],
    "*.{js,mjs,json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "supabase": "^2.117.0",
    "turbo": "^2.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
