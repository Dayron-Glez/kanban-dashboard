// Modelo de destino de Cauce, con la API en NestJS y la base en Neon.
// Es un diseño, no el DDL definitivo: lo implementa el esquema de Drizzle.
// Para verlo, pega este fichero en https://dbdiagram.io/d
//
// Reglas:
// - Un esquema de Postgres por módulo de la API; cada módulo solo escribe en el suyo.
// - FK libres hacia identity y core (usuario y proyecto son el núcleo compartido).
// - Entre módulos, como mucho referencias en un solo sentido y documentadas:
//   nunca ciclos. Hoy solo hay un módulo, calendar.
// - Identificadores en inglés; todo lo que ve el usuario, en español.

Project cauce_destino {
  database_type: 'PostgreSQL'
  Note: 'Base en Neon. Autorización en los guards de Nest; autenticación con better-auth.'
}

// ── identity ─────────────────────────────────────────────────────────────
// Tablas de better-auth. Los ids son los mismos uuid de auth.users: al importar
// los usuarios, todas las FK siguen apuntando a la misma persona.

Enum identity.provider {
  credential [note: 'Email y contraseña']
  google
}

Table identity.users {
  id uuid [pk, note: 'Mismo id que en auth.users']
  name text [not null, note: 'Antes profiles.full_name']
  email text [not null, unique]
  email_verified boolean [not null, default: false]
  image text [note: 'Antes profiles.avatar_url']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Sustituye a auth.users y a public.profiles.'
}

Table identity.accounts {
  id uuid [pk]
  user_id uuid [not null, ref: > identity.users.id]
  provider_id identity.provider [not null]
  account_id text [not null, note: 'Id en el proveedor; para credential, el propio user_id']
  password text [note: 'Hash bcrypt importado de auth.users.encrypted_password']
  access_token text
  refresh_token text
  id_token text
  access_token_expires_at timestamptz
  refresh_token_expires_at timestamptz
  scope text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (provider_id, account_id) [unique]
  }
}

Table identity.sessions {
  id uuid [pk]
  user_id uuid [not null, ref: > identity.users.id]
  token text [not null, unique]
  expires_at timestamptz [not null]
  ip_address text
  user_agent text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table identity.verifications {
  id uuid [pk]
  identifier text [not null, note: 'Email o usuario al que va el código']
  value text [not null]
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Verificación de email y recuperación de contraseña.'
}

// ── core ─────────────────────────────────────────────────────────────────

Enum core.member_role {
  owner [note: 'Propietario']
  member [note: 'Miembro']
}

Enum core.invitation_status {
  pending [note: 'Pendiente']
  accepted [note: 'Aceptada']
}

Enum core.project_kind {
  film [note: 'Cine']
  series [note: 'Serie']
  documentary [note: 'Documental']
}

Table core.projects {
  id uuid [pk]
  owner_id uuid [not null, ref: > identity.users.id]
  kind core.project_kind [not null, default: 'film', note: 'Decide la plantilla con la que nace el calendario']
  name text [not null]
  description text
  color text [not null]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Una producción. Su plan vive en calendar.'
}

Table core.project_members {
  id uuid [pk]
  project_id uuid [not null, ref: > core.projects.id]
  user_id uuid [not null, ref: > identity.users.id]
  role core.member_role [not null, default: 'member']
  is_favorite boolean [not null, default: false]
  joined_at timestamptz [not null, default: `now()`]

  indexes {
    (project_id, user_id) [unique]
  }

  Note: 'Quién tiene cuenta y acceso. El equipo de rodaje, con o sin cuenta, va en core.crew_members.'
}

Table core.project_invitations {
  id uuid [pk]
  project_id uuid [not null, ref: > core.projects.id]
  email text [not null]
  token uuid [not null, unique]
  status core.invitation_status [not null, default: 'pending']
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table core.departments {
  id uuid [pk]
  project_id uuid [not null, ref: > core.projects.id]
  name text [not null, note: 'Producción, Dirección, Arte, Fotografía, Sonido…']
  position integer [not null]

  indexes {
    (project_id, name) [unique]
  }

  Note: 'Departamentos del proyecto. Se siembran al crearlo (los 16 del prototipo del productor y Reparto, tras Casting) y se editan libremente. Compartidos: los usan el Calendario, las alertas y los módulos futuros.'
}

Table core.crew_members {
  id uuid [pk]
  project_id uuid [not null, ref: > core.projects.id]
  user_id uuid [ref: > identity.users.id, note: 'Opcional: la mayoría del equipo no tiene cuenta']
  department_id uuid [ref: > core.departments.id]
  full_name text [not null]
  job_title text [note: 'Cargo: director de producción, ayudante de dirección, foquista…']
  email text [note: 'Para enviarle avisos aunque no tenga cuenta']
  phone text

  Note: 'El equipo del proyecto, con o sin cuenta. Compartido: el Calendario asigna elementos y el Plan de rodaje o el Presupuesto usarán a las mismas personas.'
}

Table core.files {
  id uuid [pk]
  project_id uuid [not null, ref: > core.projects.id]
  name text [not null]
  content_type text [not null]
  size_bytes bigint [not null]
  storage_key text [not null, unique, note: 'Dónde está el fichero en el almacenamiento (por decidir, p. ej. Cloudflare R2)']
  uploaded_by uuid [ref: > identity.users.id]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Los datos de cada fichero subido; el contenido vive en el almacenamiento. Compartido: cada módulo enlaza los suyos.'
}

Enum core.work_day_kind {
  holiday [note: 'Festivo']
  special [note: 'F.Especial: Jueves y Viernes Santo, y los que añade el art. 23 del convenio (1 y 6 de enero; 24, 25 y 31 de diciembre). Festivos muy familiares: se intenta no trabajarlos y, si se trabajan, con más recargo que un festivo']
  weekend_worked [note: 'Día no laborable habitual (normalmente sábado o domingo) que se trabaja']
}

Enum core.holiday_scope {
  national [note: 'Estatal']
  regional [note: 'Autonómico']
  provincial
  local
}

Table core.work_calendars {
  project_id uuid [pk, ref: - core.projects.id]
  country text [not null, default: 'ES']
  region text [note: 'Código de comunidad autónoma, p. ej. ES-AN']
  province text
  locality text [note: 'Todo el proyecto usa los festivos de un solo lugar, aunque se ruede en varios']
  timezone text [not null, default: 'Europe/Madrid', note: 'Zona de las horas de los elementos del Calendario']
  working_weekdays smallint[] [not null, default: '{1,2,3,4,5}', note: 'Días laborables habituales, ISO: 1 lunes … 7 domingo. Por defecto, de lunes a viernes']

  Note: 'El calendario laboral del proyecto: dónde se trabaja, en qué zona horaria y qué días. El lugar decide qué festivos se siembran con date-holidays. Compartido: lo usan el Calendario, y lo usarán el Plan de rodaje y el Presupuesto.'
}

Table core.work_calendar_days {
  id uuid [pk]
  project_id uuid [not null, ref: > core.projects.id]
  date date [not null]
  kind core.work_day_kind [not null]
  name text [note: 'Conmemoración: Navidad, San Isidro…']
  scope core.holiday_scope
  is_provisional boolean [not null, default: false, note: 'Festivo aún sin publicar en el boletín oficial (BOE, BOJA…) de ese año']
  is_worked boolean [not null, default: false, note: 'Festivo o F.Especial que se trabaja: sigue contando como tal para la penalización']
  is_seeded boolean [not null, default: true, note: 'false si lo añadió o cambió el usuario']

  indexes {
    (project_id, date) [unique]
  }

  Note: 'Los siete días de la semana existen; aquí solo van las excepciones a la semana laborable: festivos, días F.Especial y días no laborables que se trabajan.'
}

// Alertas: un suceso que impide hacer algo durante unas fechas (un actor con un
// compromiso previo, alguien que enferma, una huelga). No son elementos del
// árbol ni las mueve el motor: sus fechas vienen de fuera. Sus conflictos con
// el plan se calculan (@repo/domain), no se guardan; nunca mueven fechas.

Enum core.alert_cause {
  unavailability [note: 'Indisponibilidad']
  illness [note: 'Enfermedad']
  strike [note: 'Huelga']
  weather [note: 'Meteorología']
  permits [note: 'Permisos']
  supplier [note: 'Proveedor']
  other [note: 'Otro']
}

Enum core.alert_certainty {
  confirmed [note: 'Segura']
  possible [note: 'Posible: una huelga anunciada puede desconvocarse']
}

Enum core.alert_scope {
  project [note: 'Todo el proyecto']
  targeted [note: 'Personas y departamentos, en core.alert_targets']
}

Enum core.hours_mode {
  daily [note: 'Cada día: las mismas horas cada día, del 16 al 20 de 9:00 a 14:00']
  continuous [note: 'Seguido: de la hora de inicio del primer día a la de fin del último, del 16 a las 22:00 al 18 a las 6:00']
}

Table core.alerts {
  id uuid [pk]
  project_id uuid [not null, ref: > core.projects.id]
  title text [not null, note: 'Hasta 120 caracteres']
  cause core.alert_cause [not null]
  certainty core.alert_certainty [not null, default: 'confirmed']
  scope core.alert_scope [not null, note: 'Explícito: si se borran sus departamentos o personas, la alerta no pasa sola a ser de todo el proyecto']
  starts_on date [not null]
  ends_on date [note: 'Vacía: hasta nuevo aviso']
  all_day boolean [not null, default: true]
  start_time time [note: 'Hora local del proyecto, sin zona, como las fechas del motor. Vacía si es todo el día']
  end_time time
  hours_mode core.hours_mode [note: 'Solo con horas y varios días (o sin fin)']
  notes text
  created_by uuid [ref: > identity.users.id, note: 'Pasa a null si se borra el usuario']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (project_id, starts_on)
  }

  Note: '''
  El «Cuándo» es el mismo que el de las acciones (calendar.elements), más el fin abierto. Reglas (CHECK, y las mismas en contracts):
  - ends_on >= starts_on;
  - todo el día: sin horas ni horario;
  - con horas: hay start_time;
  - un solo día con horas: end_time > start_time y sin horario;
  - varios días con horas, o sin fin: con horario;
  - daily: end_time > start_time (lo que cruza la medianoche es continuous);
  - continuous: end_time vacía si y solo si no hay fin («desde el 16 a las 22:00, hasta nuevo aviso»).
  Afecta a todo el proyecto o a una mezcla de personas y departamentos; «todo el proyecto» excluye lo demás. Los elementos del árbol no son alcance: el efecto sobre ellos se calcula.
  Una acción o un proceso choca con una alerta si se cruzan sus fechas y horas y además la alerta es de todo el proyecto, o en el elemento interviene una persona afectada, o hay un departamento afectado (directamente o por el de sus personas). Sin horas en el elemento, cuenta como de día entero, y contra una alerta con horas el conflicto es parcial.
  Compartida: la usarán el Plan de rodaje y el personal.
  '''
}

Table core.alert_targets {
  id uuid [pk]
  alert_id uuid [not null, ref: > core.alerts.id, note: 'Se borra con la alerta']
  department_id uuid [ref: > core.departments.id, note: 'Se borra con el departamento']
  crew_member_id uuid [ref: > core.crew_members.id, note: 'Se borra con la persona']

  indexes {
    (alert_id, department_id) [unique]
    (alert_id, crew_member_id) [unique]
  }

  Note: 'A quién afecta una alerta de scope targeted: un departamento o una persona del equipo (CHECK: uno de los dos).'
}

// ── calendar ─────────────────────────────────────────────────────────────
// El módulo Calendario. Fases, subfases, procesos y acciones son un solo árbol
// de elementos con un tipo explícito: comparten atributos, pueden cruzar fases
// y se colocan en el tiempo igual. El ancla suele ser el inicio de rodaje; el
// resto del plan se calcula a partir de ella y de las dependencias.

Enum calendar.element_kind {
  phase [note: 'Fase. Raíz del árbol']
  subphase [note: 'Subfase. Cuelga de una fase']
  process [note: 'Proceso. Cuelga de una fase o de una subfase']
  event [note: 'Evento. Acción: periodo o un día']
  task [note: 'Tarea. Acción: periodo o un día']
  meeting [note: 'Reunión. Acción: solo un día']
  reminder [note: 'Recordatorio. Acción: solo un día']
  hiring [note: 'Contratación. Acción: periodo de la fecha de alta a la de baja; sin baja, sigue activa']
  travel [note: 'Viaje. Acción: de la salida de la ida a la llegada final; un día o varios']
}

Enum calendar.duration_unit {
  days [note: 'Días']
  weeks [note: 'Semanas: siete días']
  months [note: 'Meses de calendario, como EDATE: del 31 de enero, al 28 de febrero']
}

Enum calendar.day_basis {
  calendar [note: 'Naturales: los siete días, de lunes a domingo. La base por defecto']
  working [note: 'Laborables: los días laborables de la semana del proyecto, sin festivos. Para las excepciones']
}

Enum calendar.date_point {
  start [note: 'Inicio']
  end [note: 'Fin']
}

Enum calendar.dependency_join {
  all [note: 'Todas: espera a todas (el inicio más tardío, el fin más temprano). «Cuando acaben Edición y VFX»']
  any [note: 'Cualquiera: basta la primera (el inicio más temprano). «Con lo primero que empiece de Rodaje o sus bloques»']
}

Enum calendar.assignee_role {
  responsible [note: 'Responsable']
  executor [note: 'Ejecutante']
}

Enum calendar.notification_anchor {
  start [note: 'Respecto al comienzo']
  end [note: 'Respecto al fin']
}

Enum calendar.notification_unit {
  minutes
  hours
  days
  weeks
}

Enum calendar.notification_channel {
  app [note: 'Aviso dentro de la app']
  email [note: 'Correo']
  push [note: 'Notificación en el móvil']
}

Enum calendar.priority {
  high [note: 'Alta']
  normal [note: 'Normal']
  low [note: 'Baja']
}

Table calendar.elements {
  id uuid [pk]
  project_id uuid [not null, ref: > core.projects.id]
  kind calendar.element_kind [not null]
  parent_id uuid [ref: > calendar.elements.id, note: 'La fase, subfase o proceso al que pertenece: donde empieza. Vacío solo en las fases: no hay acciones sueltas']
  position integer [not null, note: 'Orden entre hermanos']
  name text [not null, note: 'Rodaje, Rodaje 2 (Almería), Montaje de Sonido, Foley, Reunión de producción…']
  color text
  template_key text [note: 'De qué pieza de la plantilla salió (p. ej. postproduccion.vfx.render). Vacío si lo creó el usuario. No bloquea nada: todo se puede renombrar o borrar']
  description text [note: 'Información del elemento']
  notes text
  location text [note: 'Por ahora texto libre. Con el Plan de rodaje, las localizaciones serán una entidad de core']
  completed_at timestamptz [note: 'Solo en tareas (CHECK): cuándo se marcó hecha. Vacía: pendiente']
  completed_by uuid [ref: > identity.users.id]
  priority calendar.priority [note: 'Solo para resolver conflictos entre acciones que se solapan; normal si no se indica']
  recurrence_rule text [note: 'Si se repite y con qué ciclo, en formato RRULE (RFC 5545). Las repeticiones se calculan al consultar']
  starts_on date [note: 'Calculada por el motor de fechas, salvo en el ancla y en los elementos fijados']
  ends_on date [note: 'En reuniones y recordatorios, igual que starts_on (CHECK). En una contratación es la baja: vacía mientras sigue activa']
  all_day boolean [not null, default: true, note: 'El mismo «Cuándo» que core.alerts, sin el fin abierto (salvo en la contratación), y con las mismas reglas']
  start_time time [note: 'Hora en la zona del proyecto (core.work_calendars.timezone). Vacía: todo el día']
  end_time time
  hours_mode core.hours_mode [note: 'Cada día o seguido, con horas y varios días']
  duration_amount numeric
  duration_unit calendar.duration_unit
  duration_basis calendar.day_basis [not null, default: 'calendar', note: 'Naturales por defecto; laborables en las excepciones. Los laborables salen de core.work_calendars']
  is_anchor boolean [not null, default: false, note: 'La fecha que se escribe a mano y de la que sale el plan. Normalmente el inicio de rodaje']
  is_pinned boolean [not null, default: false, note: 'Fijado: no lo mueve el motor de fechas y corta la propagación']
  dependency_join calendar.dependency_join [not null, default: 'all', note: 'Cómo se combinan sus dependencias si tiene varias']
  created_by uuid [ref: > identity.users.id]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    project_id [unique, name: 'elements_one_anchor_per_project', note: 'Parcial: WHERE is_anchor']
    (parent_id, position)
    (project_id, starts_on)
  }

  Note: '''
  Un solo árbol, de hasta cuatro niveles: fase ⊃ subfase ⊃ proceso ⊃ acción, con niveles que se pueden saltar (un proceso puede colgar de la fase; en Postproducción conviven subfases y procesos). El tipo es explícito: la profundidad no lo dice.
  Reglas que comprueba la API: qué tipo puede colgar de cuál; las acciones no tienen hijos; solo las fases no tienen padre.
  Lo que se ve es lo que se calcula, sin ajustes ocultos: escribir una fecha reescribe el desfase o la duración que la produce, o fija el elemento si no depende de nada (ver docs/modelo/README.md, «Editar el plan»).
  Las fechas no están limitadas por las del padre: un elemento puede empezar en una fase y acabar en otra, y pertenece a aquella en la que empieza. Si al mover fechas su inicio sale del padre, la app avisa y ofrece cambiarlo de fase; nunca lo cambia sola.
  '''
}

Table calendar.element_dependencies {
  id uuid [pk]
  project_id uuid [not null, ref: > core.projects.id]
  predecessor_id uuid [not null, ref: > calendar.elements.id]
  successor_id uuid [not null, ref: > calendar.elements.id]
  predecessor_point calendar.date_point [not null, default: 'end', note: 'De qué fecha del otro elemento se parte']
  successor_point calendar.date_point [not null, default: 'start', note: 'Qué fecha de este elemento fija']
  lag_amount numeric [not null, default: 0, note: 'Puede ser negativo: VFX empieza cuatro semanas antes de que acabe Edición']
  lag_unit calendar.duration_unit [not null, default: 'days']
  lag_basis calendar.day_basis [not null, default: 'calendar']

  indexes {
    (predecessor_id, successor_id, successor_point) [unique, note: 'Con (predecessor_id, successor_id), el Shooting no podría depender a la vez del inicio y del fin de Rodaje']
  }

  Note: '''
  Fija el inicio o el fin de un elemento (successor) a partir del inicio o el fin de otro (predecessor), más un desfase. El desfase es aritmética literal, sin días implícitos:
  - fin → inicio, +1 día: empieza el día siguiente al fin del otro (Explotación tras Postproducción);
  - inicio → inicio, 0: empieza el mismo día (Edición con Postproducción);
  - inicio → fin, −1 día: termina el día anterior al inicio del otro, y su inicio sale de contar la duración hacia atrás (Preparación antes de Rodaje);
  - fin → inicio, −4 semanas: «−4 semanas fin de Edición», 28 días antes del fin de Edición.
  Como mucho una dependencia fija cada extremo de un elemento; varias sobre el mismo extremo se combinan según su dependency_join: todas (gana la más restrictiva) o cualquiera (gana la primera). Así «cuando acaben Edición y VFX» y «con lo primero que empiece de Rodaje o sus bloques» se expresan sin tipos especiales.
  Los ciclos los rechaza la API al crearlas (CHECK predecessor <> successor en la base).
  '''
}

// Atributos comunes: valen para cualquier elemento, de una fase a un recordatorio.

Table calendar.element_assignees {
  element_id uuid [not null, ref: > calendar.elements.id]
  crew_member_id uuid [not null, ref: > core.crew_members.id]
  role calendar.assignee_role [not null, default: 'executor']

  indexes {
    (element_id, crew_member_id) [pk]
  }

  Note: 'Participantes: el responsable y los ejecutantes, con su cargo concreto (core.crew_members.job_title). Sustituye a tasks.assignee_id.'
}

Table calendar.element_departments {
  element_id uuid [not null, ref: > calendar.elements.id]
  department_id uuid [not null, ref: > core.departments.id]

  indexes {
    (element_id, department_id) [pk]
  }
}

Table calendar.element_guests {
  id uuid [pk]
  element_id uuid [not null, ref: > calendar.elements.id]
  crew_member_id uuid [ref: > core.crew_members.id]
  email text [note: 'Invitado de fuera del equipo']
  full_name text

  Note: 'Invitados: alguien del equipo o un correo suelto (CHECK: uno de los dos).'
}

Table calendar.element_notifications {
  id uuid [pk]
  element_id uuid [not null, ref: > calendar.elements.id]
  relative_to calendar.notification_anchor [not null, default: 'start']
  offset_amount integer [not null, default: 1, note: 'Cuánto antes avisar']
  offset_unit calendar.notification_unit [not null, default: 'days']
  channel calendar.notification_channel [not null, default: 'app']
  sent_at timestamptz [note: 'Vacío hasta que se envía']

  Note: 'Avisos de comienzo y de fin. Un elemento puede tener varios: un día antes por correo, una hora antes en el móvil.'
}

Table calendar.alert_conflict_reviews {
  alert_id uuid [not null, ref: > core.alerts.id, note: 'Se borra con la alerta']
  element_id uuid [not null, ref: > calendar.elements.id, note: 'Se borra con el elemento']
  reviewed_by uuid [ref: > identity.users.id, note: 'Pasa a null si se borra el usuario']
  reviewed_at timestamptz [not null, default: `now()`]

  indexes {
    (alert_id, element_id) [pk]
  }

  Note: '«Lo asumo»: el conflicto de esta alerta con este elemento está revisado y deja de avisar. En calendar porque apunta a un elemento; core nunca apunta a calendar.'
}

Table calendar.element_links {
  id uuid [pk]
  element_id uuid [not null, ref: > calendar.elements.id]
  url text [not null]
  title text
  position integer [not null]
}

Table calendar.element_attachments {
  element_id uuid [not null, ref: > calendar.elements.id]
  file_id uuid [not null, ref: > core.files.id]

  indexes {
    (element_id, file_id) [pk]
  }

  Note: 'El repositorio de documentos de cada elemento.'
}
